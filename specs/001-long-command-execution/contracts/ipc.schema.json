{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://longrun.local/schemas/ipc-v1.json",
  "title": "Longrun Supervisor IPC V1",
  "description": "Each message is one UTF-8 JSON payload prefixed with its unsigned 32-bit big-endian byte length. Frames over 1048576 bytes and protocol versions other than 1 are rejected.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "request_id", "method", "params"],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "method": {
          "enum": [
            "submit",
            "wait",
            "status",
            "list",
            "logs",
            "cancel",
            "gc",
            "health",
            "shutdown"
          ]
        },
        "params": {
          "type": "object"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "request_id", "ok"],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "ok": {
          "type": "boolean"
        },
        "result": {},
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "job_id", "event"],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "event": {
          "enum": ["accepted", "started", "output_available", "completed"]
        },
        "payload": {}
      }
    }
  }
}
