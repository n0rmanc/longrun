{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "__LONGRUN_UNIX_PRE_TOOL_USE__",
            "commandWindows": "__LONGRUN_WINDOWS_PRE_TOOL_USE__"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "__LONGRUN_UNIX_POST_TOOL_USE__",
            "commandWindows": "__LONGRUN_WINDOWS_POST_TOOL_USE__",
            "timeout": 86410,
            "additionalContextLimit": 0,
            "statusMessage": "Longrun is waiting locally for the command."
          }
        ]
      }
    ]
  }
}
